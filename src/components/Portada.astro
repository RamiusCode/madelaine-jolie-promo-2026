---
// src/components/Portada.astro - Portada de graduación: fondo azul noche con
// destellos verdes, el birrete arriba, "Estás invitado a la ceremonia de
// graduación...", el sobre plateado al centro y "Click para abrir..." abajo.
// Todo va dentro de un marco dorado suave: doble filete tenue y una
// filigrana discreta en cada esquina.
// El sobre entero es el botón. Al tocarlo no se mueve ni tiembla: la
// portada se disuelve en una luz suave hacia la primera sección
// (NombresFlores, #sobre-novios).
// La melodía arranca en ese toque (ver abrirTodo, en el script): es el
// único momento en que el navegador deja sonar un audio, porque hace falta
// un gesto de la persona. Desde ahí la maneja BotonMusica.astro.
//
// Imágenes (webp comprimidas; los png originales quedan de respaldo):
//   /imagenes/portada-fondo.webp     fondo azul/verde (vertical)
//   /imagenes/portada-sombrero.webp  birrete con pergamino
//   /imagenes/portada-sobre.webp     sobre plateado con lacre
// ── DATOS EDITABLES ───────────────────────────────────────────
const tituloGrande = "Estás invitado";
const tituloResto = "a la ceremonia de graduación...";
const llamada = "Click para abrir ...";
// ──────────────────────────────────────────────────────────────

/*
   Motas de luz. Los valores se calculan acá y no en el script
   para que el servidor y el navegador dibujen exactamente lo mismo.
*/
const motas = Array.from({ length: 20 }, (_, i) => ({
    izq: 6 + ((i * 41) % 88),
    dur: 8 + ((i * 3) % 7),
    retraso: (i * 1.1) % 9,
    tam: 2 + (i % 3) * 1.2,
    deriva: ((i * 17) % 40) - 20,
    verde: i % 2 === 0,
}));
---

<!-- CAPA BLANCA DE TRANSICIÓN — tapa el fondo del layout durante el fade -->
<div
    id="capa-blanca"
    style="
    position: fixed;
    inset: 0;
    background-image: linear-gradient(#ffffff, #ffffff);
    z-index: 8499;
    opacity: 1;
    pointer-events: none;
"
>
</div>

<!--
   La portada va por debajo del botón flotante de música (z 9000) para que
   el control siga accesible mientras la portada se desvanece.
-->
<section
    class="fixed inset-0 w-full flex justify-center z-[8500]"
    id="portada-section"
>
    <!-- Columna de celular: en tablet / PC no se estira de costado -->
    <div class="marco" id="marco-portada">
        <!-- Aura azul/verde detrás del sobre -->
        <div class="aura" id="aura" aria-hidden="true"></div>

        <!--
           Marco dorado: doble filete, filigranas en las cuatro esquinas
           (la misma pieza espejada) y un adorno con gema arriba y abajo.
           El degradado dorado se define una sola vez y lo usan todas.
        -->
        <div class="marco-oro" aria-hidden="true">
            <svg width="0" height="0" class="defs-oro">
                <defs>
                    <linearGradient id="po-oro" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#fff3cf"></stop>
                        <stop offset="0.45" stop-color="#e2b866"></stop>
                        <stop offset="1" stop-color="#94652a"></stop>
                    </linearGradient>
                    <radialGradient id="po-gema" cx="0.35" cy="0.3" r="0.8">
                        <stop offset="0" stop-color="#d8ecff"></stop>
                        <stop offset="0.45" stop-color="#2f74d8"></stop>
                        <stop offset="1" stop-color="#0b2766"></stop>
                    </radialGradient>
                    <symbol id="po-esquina" viewBox="0 0 120 120">
                        <g
                            fill="none"
                            stroke="url(#po-oro)"
                            stroke-width="2.4"
                            stroke-linecap="round"
                        >
                            <path d="M6 78 V20 Q6 6 20 6 H78"></path>
                            <path d="M16 60 Q16 16 60 16"></path>
                            <path
                                d="M78 6 q10 0 13 7 q3 8 -5 10 q-7 1 -7 -5 q0 -4 4 -4"
                            ></path>
                            <path
                                d="M6 78 q0 10 7 13 q8 3 10 -5 q1 -7 -5 -7 q-4 0 -4 4"
                            ></path>
                            <path
                                d="M28 28 q14 -4 19 7 q4 9 -5 11 q-7 1 -7 -5"
                            ></path>
                            <path
                                d="M28 28 q-4 14 7 19 q9 4 11 -5 q1 -7 -5 -7"
                            ></path>
                            <path d="M60 16 q12 2 18 10"></path>
                            <path d="M16 60 q2 12 10 18"></path>
                        </g>
                        <g fill="url(#po-oro)">
                            <path d="M44 9 q6 -6 12 0 q-6 5 -12 0z"></path>
                            <path d="M9 44 q-6 6 0 12 q5 -6 0 -12z"></path>
                            <circle cx="91" cy="11" r="2"></circle>
                            <circle cx="11" cy="91" r="2"></circle>
                        </g>
                        <circle
                            cx="20"
                            cy="20"
                            r="6.5"
                            fill="url(#po-gema)"
                            stroke="url(#po-oro)"
                            stroke-width="2"></circle>
                    </symbol>
                </defs>
            </svg>

            <span class="rombo r-arriba"></span>
            <span class="rombo r-abajo"></span>

            <svg class="esquina e-si"><use href="#po-esquina"></use></svg>
            <svg class="esquina e-sd"><use href="#po-esquina"></use></svg>
            <svg class="esquina e-ii"><use href="#po-esquina"></use></svg>
            <svg class="esquina e-id"><use href="#po-esquina"></use></svg>
        </div>

        <!-- Motas de luz que suben -->
        <div class="motas" aria-hidden="true">
            {
                motas.map((c) => (
                    <span
                        class:list={["mota", { verde: c.verde }]}
                        style={`left:${c.izq}%; width:${c.tam}px; height:${c.tam}px; --deriva:${c.deriva}px; animation-duration:${c.dur}s; animation-delay:-${c.retraso}s;`}
                    />
                ))
            }
        </div>

        <!-- Contenido: birrete, título, sobre y llamada -->
        <div class="contenido">
            <div class="cabecera" id="cabecera">
                <img
                    src="/imagenes/portada-sombrero.webp"
                    alt=""
                    width="700"
                    height="467"
                    class="sombrero"
                    aria-hidden="true"
                    fetchpriority="high"
                />
                <h1 class="titulo">
                    <span class="titulo-grande">{tituloGrande}</span>
                    <span class="titulo-resto">{tituloResto}</span>
                </h1>
                <span class="divisor" aria-hidden="true"></span>

                <!-- Foto de la promoción, en un marco dorado fino -->
                <figure class="foto-promo">
                    <img
                        src="/imagenes/portada-promocion.webp"
                        alt="Promoción 2026, U. E. Libertador Simón Bolívar"
                        width="640"
                        height="482"
                        decoding="async"
                    />
                </figure>
            </div>

            <button
                id="btn-sobre"
                type="button"
                aria-label="Abrir la invitación"
                class="sobre-boton"
            >
                <span class="sobre-flota" id="sobre-flota">
                    <img
                        src="/imagenes/portada-sobre.webp"
                        alt=""
                        width="877"
                        height="567"
                        class="sobre"
                        aria-hidden="true"
                        fetchpriority="high"
                    />
                    <!-- Reflejo plateado que recorre el sobre: usa el propio
                         dibujo como máscara, la luz solo cae sobre el sobre -->
                    <span class="brillo" aria-hidden="true"></span>
                    <!-- Resplandor del lacre, al centro del sobre -->
                    <span class="lacre-luz" id="lacre-luz"></span>
                </span>
            </button>

            <p id="llamada-portada" class="llamada"><span>{llamada}</span></p>
        </div>

        <!-- Resplandor final al abrir -->
        <div class="resplandor" id="resplandor" aria-hidden="true"></div>
    </div>
</section>

<style>
    body.portada-activa {
        overflow: hidden !important;
        height: 100vh !important;
    }

    #capa-blanca {
        transition: opacity 0.4s ease;
    }

    /*
       Afuera de la columna (PC / tablet) va el mismo azul noche del
       fondo. Declarado como degradado y no como color: el modo oscuro
       forzado oscurece colores pero respeta las imágenes.
    */
    #portada-section {
        height: 100vh;
        height: 100dvh;
        background-image: radial-gradient(
            ellipse at 50% 45%,
            #0a1a3a 0%,
            #050d22 60%,
            #02060f 100%
        );
    }

    /* ── Marco / fondo ──────────────────────────────────────── */
    .marco {
        position: relative;
        width: 100%;
        max-width: 480px;
        height: 100%;
        overflow: hidden;
        background-color: #050d22;
        /* Fondo vertical: cubre toda la pantalla sin deformarse */
        background-image: url("/imagenes/portada-fondo.webp");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        box-shadow: 0 0 60px rgba(30, 160, 140, 0.2);
        isolation: isolate;
    }

    /* ── Aura detrás del sobre ──────────────────────────────── */
    .aura {
        position: absolute;
        left: 50%;
        top: 52%;
        width: 120%;
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        background-image: radial-gradient(
            circle,
            rgba(110, 190, 255, 0.34) 0%,
            rgba(40, 150, 150, 0.18) 32%,
            rgba(20, 80, 120, 0) 62%
        );
        animation: latir 4.5s ease-in-out infinite;
        pointer-events: none;
        z-index: 1;
    }

    @keyframes latir {
        0%,
        100% {
            opacity: 0.7;
            transform: translate(-50%, -50%) scale(0.95);
        }
        50% {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1.06);
        }
    }

    /* ── Marco dorado ───────────────────────────────────────── */
    /*
       Doble filete dorado a 10px del borde, con las piezas de adorno
       encima. No se puede tocar, así nunca le quita el toque al sobre.
    */
    .marco-oro {
        position: absolute;
        inset: 10px;
        z-index: 4;
        pointer-events: none;
        border: 1px solid rgba(226, 184, 102, 0.6);
        border-radius: 6px;
    }

    /* El segundo filete, más fino y tenue, por dentro */
    .marco-oro::before {
        content: "";
        position: absolute;
        inset: 5px;
        border: 1px solid rgba(226, 184, 102, 0.25);
        border-radius: 4px;
    }

    .defs-oro {
        position: absolute;
    }

    /* Las cuatro esquinas: la misma pieza, espejada */
    .esquina {
        position: absolute;
        width: min(15vw, 66px);
        height: min(15vw, 66px);
        overflow: visible;
        opacity: 0.8;
    }

    .e-si {
        top: -5px;
        left: -5px;
    }

    .e-sd {
        top: -5px;
        right: -5px;
        transform: scaleX(-1);
    }

    .e-ii {
        bottom: -5px;
        left: -5px;
        transform: scaleY(-1);
    }

    .e-id {
        bottom: -5px;
        right: -5px;
        transform: scale(-1, -1);
    }

    /* ── Motas que suben ────────────────────────────────────── */
    .motas {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 2;
    }

    .mota {
        position: absolute;
        bottom: 6%;
        border-radius: 50%;
        background-image: radial-gradient(
            circle,
            rgba(215, 235, 255, 1) 0%,
            rgba(150, 200, 255, 0) 70%
        );
        box-shadow: 0 0 6px rgba(170, 215, 255, 0.8);
        animation-name: subir;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
        opacity: 0;
    }

    .mota.verde {
        background-image: radial-gradient(
            circle,
            rgba(190, 255, 225, 1) 0%,
            rgba(60, 200, 150, 0) 70%
        );
        box-shadow: 0 0 6px rgba(90, 230, 180, 0.8);
    }

    @keyframes subir {
        0% {
            transform: translate(0, 0);
            opacity: 0;
        }
        12% {
            opacity: 0.9;
        }
        75% {
            opacity: 0.45;
        }
        100% {
            transform: translate(var(--deriva), -82dvh);
            opacity: 0;
        }
    }

    /* ── Contenido ──────────────────────────────────────────── */
    .contenido {
        position: relative;
        z-index: 3;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-evenly;
        /* Deja libres los adornos del marco, arriba y abajo */
        padding: 7dvh 9% 7dvh;
        box-sizing: border-box;
    }

    .cabecera {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.2dvh;
        flex: 0 0 auto;
        width: 100%;
    }

    .sombrero {
        display: block;
        width: min(30%, 12dvh);
        height: auto;
        user-select: none;
        -webkit-user-drag: none;
        filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.6))
            drop-shadow(0 0 14px rgba(90, 210, 190, 0.35));
        animation: sombreroFlota 5s ease-in-out infinite;
    }

    @keyframes sombreroFlota {
        0%,
        100% {
            transform: translateY(0) rotate(-1.5deg);
        }
        50% {
            transform: translateY(-5px) rotate(1.5deg);
        }
    }

    /* "Estás invitado" en Great Vibes (sin mayúsculas forzadas ni
       espaciado); el resto, en serif recta */
    .titulo {
        margin: 0;
        max-width: 94%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4dvh;
        text-transform: none;
        text-align: center;
        background-image: linear-gradient(
            180deg,
            #ffffff 0%,
            #dbe8f7 55%,
            #a9c2de 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.75))
            drop-shadow(0 0 10px rgba(110, 200, 220, 0.4));
    }

    .titulo-grande {
        font-family: "Great Vibes", cursive;
        font-style: normal;
        font-weight: 400;
        font-size: clamp(1.8rem, min(8.2vw, 4.4dvh), 2.5rem);
        line-height: 1.15;
        letter-spacing: normal;
        text-transform: none;
    }

    .titulo-resto {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-style: normal;
        font-weight: 500;
        font-size: clamp(1rem, min(4.8vw, 2.6dvh), 1.4rem);
        line-height: 1.3;
        letter-spacing: 0.05em;
    }

    /* Filete dorado con rombo al centro, entre el título y el sobre */
    .divisor {
        position: relative;
        width: min(52%, 190px);
        height: 1px;
        margin-top: 1.4dvh;
        background-image: linear-gradient(
            90deg,
            rgba(226, 184, 102, 0),
            rgba(226, 184, 102, 0.8) 50%,
            rgba(226, 184, 102, 0)
        );
    }

    .divisor::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        width: 7px;
        height: 7px;
        transform: translate(-50%, -50%) rotate(45deg);
        background-image: linear-gradient(135deg, #fff3cf, #c99a4e);
        box-shadow: 0 0 6px rgba(255, 200, 110, 0.5);
    }

    /* Rombos pequeños, centrados arriba y abajo sobre el filete */
    /*
       Foto de la promoción: marco dorado fino con un segundo filete hacia
       afuera y un resplandor suave. El alto manda (dvh) para que entre
       entre el título y el sobre sin apretar nada.
    */
    .foto-promo {
        margin: 1.2dvh 0 0;
        width: min(62%, 21dvh);
        padding: 3px;
        box-sizing: border-box;
        border-radius: 6px;
        background-image: linear-gradient(135deg, #fff3cf, #c99a4e 50%, #8a5f1e);
        box-shadow:
            0 0 0 3px rgba(5, 13, 34, 0.55),
            0 0 0 4px rgba(226, 184, 102, 0.45),
            0 8px 20px rgba(0, 0, 0, 0.55),
            0 0 22px rgba(110, 190, 255, 0.25);
    }

    .foto-promo img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 4px;
        user-select: none;
        -webkit-user-drag: none;
    }

    .rombo {
        position: absolute;
        left: 50%;
        width: 8px;
        height: 8px;
        background-image: linear-gradient(135deg, #fff3cf, #c99a4e);
        box-shadow: 0 0 6px rgba(255, 200, 110, 0.45);
    }

    .r-arriba {
        top: -4.5px;
        transform: translateX(-50%) rotate(45deg);
    }

    .r-abajo {
        bottom: -4.5px;
        transform: translateX(-50%) rotate(45deg);
    }

    /* ── Sobre ──────────────────────────────────────────────── */
    .sobre-boton {
        display: block;
        flex: 0 0 auto;
        /* Un poco más chico para dejar lugar a la foto de la promoción */
        width: min(88%, 46dvh);
        padding: 0;
        border: 0;
        background: transparent;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .sobre-boton:focus-visible {
        outline: 2px solid rgba(200, 225, 255, 0.85);
        outline-offset: 6px;
        border-radius: 8px;
    }

    .sobre-flota {
        position: relative;
        display: block;
    }

    .sobre {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
        -webkit-user-drag: none;
        filter: drop-shadow(0 16px 26px rgba(0, 0, 0, 0.6))
            drop-shadow(0 0 22px rgba(110, 190, 255, 0.4));
    }

    /* Reflejo plateado que cruza el sobre, solo sobre su dibujo */
    .brillo {
        position: absolute;
        inset: 0;
        pointer-events: none;
        mix-blend-mode: screen;
        -webkit-mask-image: url("/imagenes/portada-sobre.webp");
        mask-image: url("/imagenes/portada-sobre.webp");
        -webkit-mask-size: 100% 100%;
        mask-size: 100% 100%;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        background-image: linear-gradient(
            105deg,
            rgba(255, 255, 255, 0) 42%,
            rgba(235, 248, 255, 0.85) 50%,
            rgba(255, 255, 255, 0) 58%
        );
        background-size: 260% 100%;
        background-repeat: no-repeat;
        background-position: 150% 0;
        animation: pasarLuz 5s ease-in-out infinite;
        animation-delay: 2.2s;
    }

    @keyframes pasarLuz {
        0% {
            background-position: 150% 0;
        }
        45%,
        100% {
            background-position: -150% 0;
        }
    }

    /* Luz sobre el lacre: queda centrada en la gema del sobre */
    .lacre-luz {
        position: absolute;
        left: 50%;
        top: 55%;
        width: 26%;
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background-image: radial-gradient(
            circle,
            rgba(210, 240, 255, 0.55) 0%,
            rgba(90, 200, 190, 0.28) 40%,
            rgba(90, 200, 190, 0) 70%
        );
        mix-blend-mode: screen;
        pointer-events: none;
        animation: lacre 3s ease-in-out infinite;
    }

    @keyframes lacre {
        0%,
        100% {
            opacity: 0.3;
            transform: translate(-50%, -50%) scale(0.9);
        }
        50% {
            opacity: 0.9;
            transform: translate(-50%, -50%) scale(1.15);
        }
    }

    /* ── Llamada ────────────────────────────────────────────── */
    .llamada {
        flex: 0 0 auto;
        margin: 0;
        /* Misma letra que "a la ceremonia de graduación...", en el color
           plateado del título */
        font-family: "Cormorant Garamond", Georgia, serif;
        font-style: normal;
        font-weight: 600;
        font-size: clamp(0.95rem, min(4.6vw, 2.5dvh), 1.3rem);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        line-height: 1.2;
        text-align: center;
        white-space: nowrap;
        background-image: linear-gradient(
            180deg,
            #ffffff 0%,
            #dbe8f7 55%,
            #a9c2de 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.8))
            drop-shadow(0 0 10px rgba(110, 200, 220, 0.4));
    }

    .llamada span {
        display: inline-block;
        animation: invitar 2.4s ease-in-out infinite;
    }

    @keyframes invitar {
        0%,
        100% {
            opacity: 0.65;
            transform: scale(0.98);
        }
        50% {
            opacity: 1;
            transform: scale(1.03);
        }
    }

    /* ── Resplandor de apertura ─────────────────────────────── */
    .resplandor {
        position: absolute;
        inset: 0;
        z-index: 5;
        opacity: 0;
        pointer-events: none;
        background-image: radial-gradient(
            circle at 50% 52%,
            #f4fbff 0%,
            #cfe6f7 35%,
            rgba(80, 170, 200, 0.6) 65%,
            rgba(10, 40, 90, 0) 100%
        );
    }

    /* Quien pidió menos movimiento, recibe menos movimiento */
    @media (prefers-reduced-motion: reduce) {
        .aura,
        .mota,
        .brillo,
        .lacre-luz,
        .sombrero,
        .llamada span {
            animation: none;
        }
        .mota {
            display: none;
        }
    }
</style>

<script>
    import { gsap } from "gsap";

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            document.body.classList.add("portada-activa");

            const boton = document.getElementById("btn-sobre");
            const flota = document.getElementById("sobre-flota");
            const cabecera = document.getElementById("cabecera");
            const llamada = document.getElementById("llamada-portada");
            const lacreLuz = document.getElementById("lacre-luz");
            const aura = document.getElementById("aura");
            const marco = document.getElementById("marco-portada");
            const resplandor = document.getElementById("resplandor");
            const seccion = document.getElementById("portada-section");
            const capaBlanca = document.getElementById("capa-blanca");
            if (!boton || !flota || !marco) return;

            const menosMovimiento = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            let abriendo = false;

            // ── Estado inicial ──────────────────────────────────────
            gsap.set(cabecera, { opacity: 0, y: -24, scale: 0.94 });
            gsap.set(flota, { opacity: 0, y: 40, scale: 0.85 });
            gsap.set(llamada, { opacity: 0, y: 12 });

            // ── Entrada ─────────────────────────────────────────────
            const tl = gsap.timeline({ delay: 0.3 });
            tl.to(cabecera, {
                opacity: 1,
                y: 0,
                scale: 1,
                duration: 1.2,
                ease: "power3.out",
            })
                .to(
                    flota,
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.2,
                        ease: "back.out(1.4)",
                    },
                    0.45,
                )
                .to(
                    llamada,
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        ease: "power2.out",
                    },
                    1.2,
                );

            // ── El sobre flota apenas ───────────────────────────────
            if (!menosMovimiento) {
                tl.add(() => {
                    if (abriendo) return;
                    gsap.to(flota, {
                        y: -8,
                        rotate: 0.6,
                        duration: 2.6,
                        repeat: -1,
                        yoyo: true,
                        ease: "sine.inOut",
                    });
                });
            }

            // ── Suelta el scroll y deja la invitación arrancada en el
            //    sobre de NombresFlores, su primera sección.
            const abrirInvitacion = () => {
                document.body.classList.remove("portada-activa");
                document.body.style.overflow = "auto";

                const destino = document.getElementById("sobre-novios");
                if (destino) {
                    destino.scrollIntoView({ block: "start" });
                } else {
                    window.scrollTo({ top: 0 });
                }

            };

            /*
               Aviso para que las secciones recién ahora arranquen su
               entrada. Va cuando la portada ya se desvaneció del todo: si
               se avisa antes, las letras entran tapadas por ella y el
               invitado no ve la animación.
            */
            const avisarApertura = () => {
                (window as any).portadaAbierta = true;
                window.dispatchEvent(new Event("portada-abierta"));
            };

            // ── Abrir la invitación ─────────────────────────────────
            const abrirTodo = () => {
                if (abriendo) return;
                abriendo = true;

                gsap.killTweensOf(flota);

                /*
                   Acá arranca la música, y tiene que ser acá: los
                   navegadores solo dejan sonar un audio si lo pide un
                   gesto de la persona. Queda en window.audioGlobal para
                   que el botón de la esquina maneje esta misma melodía.
                */
                const yaExiste = (window as any).audioGlobal as
                    | HTMLAudioElement
                    | undefined;
                const melodia = yaExiste ?? new Audio("/musica/melodia2.mp3");
                melodia.loop = true;
                melodia.volume = 0.65;
                (window as any).audioGlobal = melodia;
                melodia.play().catch(() => {});

                /*
                   Sin hundir, sin temblar y sin que el sobre se mueva:
                   al presionar, la portada se disuelve en una luz suave
                   y la invitación queda en NombresFlores.
                */
                gsap.timeline()
                    // Las animaciones de CSS le ganan a GSAP: se apagan
                    .set([lacreLuz, aura], { animation: "none" }, 0)
                    .to(
                        llamada,
                        { opacity: 0, duration: 0.3 },
                        0,
                    )
                    // Resplandor suave que llena la pantalla
                    .to(
                        resplandor,
                        { opacity: 1, duration: 0.55, ease: "power2.inOut" },
                        0.1,
                    )
                    .to(
                        seccion,
                        {
                            opacity: 0,
                            duration: 0.6,
                            ease: "power2.inOut",
                            onStart: abrirInvitacion,
                            onComplete: () => {
                                seccion?.remove();
                                // La capa blanca todavía se está yendo: las
                                // letras arrancan justo cuando se descubre
                                avisarApertura();
                                gsap.to(capaBlanca, {
                                    opacity: 0,
                                    duration: 0.4,
                                    ease: "power2.out",
                                    onComplete: () => capaBlanca?.remove(),
                                });
                            },
                        },
                        0.55,
                    );
            };

            boton.addEventListener("click", abrirTodo);

            /*
               En PC el sobre acompaña un poco al mouse; en celular, la
               inclinación del aparato. Pocos grados: alcanza para que
               parezca que flota delante del fondo.
            */
            if (!menosMovimiento && seccion) {
                const mover = (gx: number, gy: number) => {
                    if (abriendo) return;
                    gsap.to(boton, {
                        x: gx,
                        y: gy,
                        duration: 0.8,
                        ease: "power2.out",
                        overwrite: "auto",
                    });
                };
                seccion.addEventListener("mousemove", (e) => {
                    const mx = e.clientX / window.innerWidth - 0.5;
                    const my = e.clientY / window.innerHeight - 0.5;
                    mover(mx * 14, my * 10);
                });
                seccion.addEventListener("mouseleave", () => mover(0, 0));
                window.addEventListener("deviceorientation", (e) => {
                    if (e.gamma === null || e.beta === null) return;
                    const gx = Math.max(-8, Math.min(8, e.gamma / 4));
                    const gy = Math.max(-6, Math.min(6, (e.beta - 45) / 6));
                    mover(gx, gy);
                });
            }
        });
    }
</script>
